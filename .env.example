# Google Maps SDK (Android manifest + web map loader) — billing-enabled
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Gemini API (ClimaAI chat) — billing-enabled
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase client API keys (also set current_key in android/app/google-services.json)
FIREBASE_WEB_API_KEY=your_firebase_web_api_key_here
FIREBASE_ANDROID_API_KEY=your_firebase_android_api_key_here

# Supabase project URL and anon key (image uploads)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Climate news feeds (optional; news API disabled in app by default)
NEWS_API_KEY=your_newsapi_key_here
GNEWS_API_KEY=your_gnews_api_key_here
